# ==============================================
# Cosmos Video Dataset Search - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your actual values
# Example: cp .env.example .env

# ==============================================
# Required API Keys
# ==============================================

# NVIDIA API Key (required for NGC-hosted services and container pulls)
NVIDIA_API_KEY=

# ==============================================
# Data Directory
# ==============================================

# Path to your data directory (REQUIRED)
# This directory should contain your video/image files for indexing
DATA_DIR=/path/to/your/data

# ==============================================
# Infrastructure Configuration
# ==============================================

# LocalStack (AWS S3 emulation) Credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566

# ==============================================
# GPU Configuration
# ==============================================

# Which GPU(s) to use for Milvus (comma-separated device IDs)
MILVUS_CUDA_VISIBLE_DEVICES=0

# Number of GPUs for the CE1 OSS service
COSMOS_EMBED_GPUS=1

# ==============================================
# Container Images
# ==============================================

# CVDS CE1 OSS Image
# Use cvds-cosmos-embed-oss-pytorch:local after `make build-docker`, or point
# this at nvcr.io/nvidia/blueprint/cosmos-embed1-oss:1.2.0.
COSMOS_EMBED_IMAGE=cvds-cosmos-embed-oss-pytorch:local

# ==============================================
# CE1 OSS Configuration
# ==============================================

# This release supports the source-built OSS service.
COSMOS_EMBED_SERVICE_MODE=oss

# CVDS CE1 OSS backend configuration
COSMOS_EMBED_BACKEND=pytorch
COSMOS_EMBED_MODEL_VARIANT=224p
COSMOS_EMBED_MODEL_PATH=/models/cosmos-embed1
COSMOS_EMBED_MODEL_HOST_PATH=${HOME}/.cache/cosmos-embed1
COSMOS_EMBED_ALLOW_HF_DOWNLOAD=false
COSMOS_EMBED_HF_MODEL_ID=nvidia/Cosmos-Embed1-224p
# Pinned model revision used by `make download-ce1-model`.
COSMOS_EMBED_HF_REVISION=787e0b996f5260a71ad474a283c90539a2e12986
COSMOS_EMBED_LOCAL_FILES_ONLY=true
COSMOS_EMBED_MAX_MEDIA_BYTES=100663296
COSMOS_EMBED_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=300
COSMOS_EMBED_PRESIGNED_URL_ALLOWED_HOSTS=
# Optional comma-separated exact origins for trusted local HTTP media servers.
COSMOS_EMBED_PRESIGNED_URL_ALLOWED_HTTP_ORIGINS=
COSMOS_EMBED_PRESIGNED_URL_ENDPOINT_URL=
COSMOS_EMBED_SERVICE_VERSION=1.2.0
# For explicit Hugging Face loading, add docker-compose.ce1-oss-hf.yml after
# docker-compose.ce1-oss.yml and provide HF_TOKEN or HUGGING_FACE_HUB_TOKEN.
COSMOS_EMBED_HF_CACHE_HOST_PATH=${HOME}/.cache/huggingface
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# ==============================================
# Visual Search Service Configuration
# ==============================================

# Gunicorn server configuration
GUNICORN_PORT=8888
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=600

# Maximum documents per upload batch
MAX_DOCS_PER_UPLOAD=3200

# Milvus connection
MILVUS_DOCUMENT_STORE_URI=http://milvus:19530
MILVUS_DB=""

# CE1 OSS service endpoint
COSMOS_EMBED_URI=http://cosmos-embed:8000

# Allowed search pipelines (comma-separated)
ALLOWED_PIPELINES=cosmos_video_search_milvus

# Logging level (DEBUG, INFO, WARNING, ERROR)
VISUAL_SEARCH_LOG_LEVEL=DEBUG
