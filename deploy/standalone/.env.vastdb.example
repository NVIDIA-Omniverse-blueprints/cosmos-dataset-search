#
# Environment template for Cosmos Dataset Search + VastDB + Vast S3
# Copy to .env and fill in your VAST cluster values:
#   cp .env.vastdb.example .env

# ==============================================
# Required
# ==============================================
NVIDIA_API_KEY=
DATA_DIR=/path/to/your/data

# ==============================================
# VastDB vector store
# ==============================================
# Query Engine / DB VIP (include http:// or https://)
VASTDB_ENDPOINT=http://<vastdb-vip>
VAST_ACCESS_KEY=<s3-access-key>
VAST_SECRET_KEY=<s3-secret-key>
VASTDB_BUCKET=cds-vastdb
VASTDB_SCHEMA=cds
VASTDB_EMBEDDING_DIM=256
VASTDB_SSL_VERIFY=false

# Host path that contains libadbc_driver_vastdb.so (mounted into the container)
VAST_ADBC_DRIVER_HOST_PATH=/opt/adbc-driver
VAST_ADBC_DRIVER_PATH=/opt/adbc-driver/libadbc_driver_vastdb.so

# ==============================================
# Vast S3 (media objects)
# ==============================================
VAST_S3_ENDPOINT=http://<vast-s3-vip>
VAST_S3_ACCESS_KEY=<s3-access-key>
VAST_S3_SECRET_KEY=<s3-secret-key>
VAST_S3_REGION=us-east-1
VAST_S3_SSL_VERIFY=false

# CDS media fetch policy — allow your Vast S3 endpoint
AWS_ACCESS_KEY_ID=${VAST_S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${VAST_S3_SECRET_KEY}
AWS_DEFAULT_REGION=${VAST_S3_REGION}
AWS_ENDPOINT_URL=${VAST_S3_ENDPOINT}
CDS_FETCH_PRIVATE_ORIGINS=${VAST_S3_ENDPOINT}
CDS_FETCH_S3_ENDPOINTS=${VAST_S3_ENDPOINT}

# ==============================================
# CDS / CE1
# ==============================================
ALLOWED_PIPELINES=cosmos_video_search_vastdb
COSMOS_EMBED_URI=http://cosmos-embed:8000
COSMOS_EMBED_IMAGE=cvds-cosmos-embed-oss-pytorch:local
COSMOS_EMBED_SERVICE_MODE=oss
COSMOS_EMBED_BACKEND=pytorch
COSMOS_EMBED_MODEL_VARIANT=224p
COSMOS_EMBED_MODEL_PATH=/models/cosmos-embed1
COSMOS_EMBED_MODEL_HOST_PATH=${HOME}/.cache/cosmos-embed1
COSMOS_EMBED_GPUS=1
GUNICORN_PORT=8888
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=600
VISUAL_SEARCH_LOG_LEVEL=DEBUG
